# Clriks-cli demo keys
# Copy file này thành .env.local hoặc cấu hình secret trên server của bạn.
# Không commit file chứa key thật.

GITHUB_CLIENT_ID=Iv1.demo_client_id_here
GITHUB_CLIENT_SECRET=demo_client_secret_only_for_backend
GITHUB_TOKEN=ghp_demo_token_paste_here
OPENAI_API_KEY=sk-demo_paste_your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
CLRICKS_DEFAULT_REPO=owner/repository
CLRICKS_AGENT_SANDBOX=enabled
